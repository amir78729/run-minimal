{
  "name": "run-minimal",
  "version": "1.0.0",
  "description": "Minimize successful command output to reduce AI agent token consumption for linting, formatting, and tests.",
  "keywords": [
    "agent",
    "ai",
    "cli",
    "lint",
    "minimal-output",
    "output-filter",
    "test",
    "token-reduction",
    "tokens"
  ],
  "homepage": "https://github.com/amir78729/run-minimal#readme",
  "bugs": {
    "url": "https://github.com/amir78729/run-minimal/issues"
  },
  "license": "MIT",
  "author": "Amirhossein Alibakhshi <amirhosseinalibakhshi@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amir78729/run-minimal.git"
  },
  "bin": {
    "run-minimal": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "lint": "oxlint",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "changeset": "changeset",
    "changeset:create": "changeset",
    "changeset:check": "changeset status",
    "changeset:empty": "changeset --empty",
    "changeset:version": "changeset version",
    "changeset:release": "pnpm run build && changeset publish",
    "prepublishOnly": "pnpm run build && pnpm run test:coverage"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.3",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
